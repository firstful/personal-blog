{
    "routes": [
        {
            "route": "/login",
            "allowedRoles": ["anonymous"],
            "rewrite": "/.auth/login/google"
        },
        {
            "route": "/logout",
            "allowedRoles": ["authenticated"],
            "rewrite": "/.auth/logout"
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/assets/*",
            "/feed_rss_created.xml",
            "/feed_rss_updated.xml",
            "/feed_atom.xml",
            "/sitemap.xml"
        ]
    },
    
    "responseOverrides": {
        "401": {
            "statusCode": 302,
            "redirect": ".auth/login/google?post_login_redirect_uri=.referrer"
        }
    }
}
