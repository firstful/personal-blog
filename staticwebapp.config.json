{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/api/*",
      "/data/*",
      "/resume/*"
    ]
  },
  "routes": [
    {
      "route": "/api/*",
      "headers": {
        "Cache-Control": "public, max-age=300"
      }
    },
    {
      "route": "/resume/*",
      "statusCode": 404
    },
    {
      "route": "/.git/*",
      "statusCode": 404
    },
    {
      "route": "/.github/*",
      "statusCode": 404
    },
    {
      "route": "/.gitea/*",
      "statusCode": 404
    },
    {
      "route": "/.mailmap",
      "statusCode": 404
    },
    {
      "route": "/AGENTS.md",
      "statusCode": 404
    },
    {
      "route": "/README.md",
      "statusCode": 404
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
