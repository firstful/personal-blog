# Test server — builds site and serves with SWA emulation for Playwright tests.
FROM docker.io/library/node:22 AS build

WORKDIR /app
COPY requirements.txt ./
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /venv && /venv/bin/pip install --no-cache-dir -r requirements.txt
ENV PATH="/venv/bin:$PATH"

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM docker.io/library/node:22
RUN npm install -g @azure/static-web-apps-cli
WORKDIR /app
COPY --from=build /app/site /app/site
EXPOSE 8000
CMD ["swa", "start", "site", "--port", "8000", "--app-location", "site", "--api-location", ""]
