{
  "name": "sutliff-blog",
  "private": true,
  "scripts": {
    "build:ts": "python3 scripts/validate-ts-modules.py && esbuild src/ts/main.ts --bundle --outfile=docs/assets/js/main.js",
    "build:css": "postcss src/css/main.css -o docs/assets/theme.css --env production",
    "build:articles": "python3 scripts/generate-articles-json.py",
    "build:site": "sed -i \"s|^site_url:.*|site_url: ${SITE_URL:-https://blog.ffilt.us/}|\" mkdocs.yml && mkdocs build",
    "build:preview": "MKDOCS_SCHEDULE_MODE=1 npm run build:site",
    "build": "npm run build:ts && npm run build:css && npm run build:articles && python3 scripts/generate-cue-pages.py && npm run build:site && python3 scripts/hash-assets.py",
    "dev:ts": "esbuild src/ts/main.ts --bundle --outfile=docs/assets/js/main.js --watch",
    "dev:css": "postcss src/css/main.css -o docs/assets/theme.css --watch",
    "dev:site": "mkdocs serve",
    "validate": "npm run build && test -f docs/index.html && echo Validation passed",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:local": "npm run build && (python3 -m http.server 8000 --directory site &) && sleep 2 && BASE_URL=http://localhost:8000 playwright test; kill %1 2>/dev/null",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "esbuild": "^0.28.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0"
  }
}
